# Public site URL — used for SEO metadata, sitemap and robots.txt
NEXT_PUBLIC_SITE_URL=https://your-domain.vercel.app

# ---------------------------------------------------------------------------
# Contact form delivery
#
# Where messages are sent. Defaults to profile.email if unset.
CONTACT_TO_EMAIL=kchitizshukla@gmail.com

# Pick ONE provider below. If neither is set, the form returns an honest
# "messaging is offline" error in production instead of silently dropping mail.

# Option A: Web3Forms (https://web3forms.com) — no account, key arrives by email.
WEB3FORMS_ACCESS_KEY=

# Option B: Resend (https://resend.com) — free tier, better deliverability.
RESEND_API_KEY=
# Sender address. onboarding@resend.dev works without verifying a domain,
# but can only deliver to the email your Resend account was created with.
CONTACT_FROM_EMAIL=onboarding@resend.dev
