# Public site URL — used for SEO metadata, sitemap and robots.txt
NEXT_PUBLIC_SITE_URL=https://your-domain.vercel.app

# Optional: enable real email delivery for the contact form (https://resend.com)
# Without these the form still works — submissions are validated and logged server-side.
RESEND_API_KEY=
CONTACT_FROM_EMAIL=onboarding@resend.dev
